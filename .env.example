# Furora Environment Variables Template

# Local SQLite Fallback
DATABASE_URL="file:./dev.db"

# Turso Cloud Database
TURSO_DATABASE_URL="libsql://furora-pets-furorapets.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# Cloudflare R2 Object Storage
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="furorapetsbucket"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://pub-55b78e48e95d40789d68e450814345d4.r2.dev"

# Hostinger SMTP Email Configuration
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="breeder@furora.in"
SMTP_PASS="your_smtp_password_here"
SMTP_FROM="Furora Partner Network <breeder@furora.in>"
